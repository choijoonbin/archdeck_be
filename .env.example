# Copy to .env. This is a local-development database owner, not an app login.
ARCHDECK_POSTGRES_IMAGE=postgres:17.12-bookworm
ARCHDECK_DB_NAME=archdeck
ARCHDECK_DB_USER=archdeck_owner
ARCHDECK_DB_PASSWORD=replace-with-a-random-local-password
# 55432 is already used by another local project. Keep ArchDeck isolated.
ARCHDECK_DB_PORT=55433
# Internal Agent service; same random secret must be injected into Agent.
ARCHDECK_AGENT_URL=http://127.0.0.1:4010
ARCHDECK_AGENT_SERVICE_TOKEN=replace-with-at-least-32-random-characters
# Local development defaults. For approved HTTPS sharing enable secure cookies.
ARCHDECK_BIND_ADDRESS=127.0.0.1
ARCHDECK_SECURE_COOKIE=false
ARCHDECK_SESSION_COOKIE_NAME=ArchDeckSession
# Bootstrap credentials are supplied once via a private process environment.
# ARCHDECK_BOOTSTRAP_USERNAME=your-admin-id
# ARCHDECK_BOOTSTRAP_PASSWORD=your-long-random-password
